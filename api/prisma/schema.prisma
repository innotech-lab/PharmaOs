generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  CASHIER
}

model Tenant {
  id             String          @id @default(cuid())
  name           String
  createdAt      DateTime        @default(now())
  users          User[]
  pharmacies     Pharmacy[]
  products       Product[]
  stockMovements StockMovement[]
  suppliers      Supplier[]
  sales          Sale[]
}

model Pharmacy {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  country        String?
  city           String?
  address        String?
  active         Boolean         @default(true)
  saleCounter    Int             @default(0)
  createdAt      DateTime        @default(now())
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users          User[]
  products       Product[]
  stock          StockLevel[]
  stockMovements StockMovement[]
  sales          Sale[]

  @@index([tenantId])
}

model Product {
  id             String          @id @default(cuid())
  tenantId       String
  pharmacyId     String
  sku            String
  name           String
  // Rayon du produit (ex. Antalgiques, Hygiène), utilisé pour les onglets de la caisse.
  category       String?
  // Montant unitaire hors taxe ; la devise est celle configurée pour l’officine.
  priceHT        Decimal         @db.Decimal(12, 2)
  tvaRate        Decimal         @db.Decimal(5, 2)
  stockThreshold Int             @default(0)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy        @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  stock          StockLevel?
  movements      StockMovement[]
  saleItems      SaleItem[]

  @@unique([pharmacyId, sku])
  @@index([tenantId, pharmacyId, active])
}

model StockLevel {
  id         String   @id @default(cuid())
  pharmacyId String
  productId  String   @unique
  quantity   Int      @default(0)
  updatedAt  DateTime @updatedAt
  pharmacy   Pharmacy @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model StockMovement {
  id         String            @id @default(cuid())
  tenantId   String
  pharmacyId String
  productId  String
  type       StockMovementType
  quantity   Int
  reason     String?
  reference  String?
  createdAt  DateTime          @default(now())
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pharmacy   Pharmacy          @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, pharmacyId, createdAt])
  @@index([productId, createdAt])
}

enum StockMovementType {
  IN
  OUT
  ADJUST
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  pharmacyId   String?
  firstName    String
  lastName     String
  email        String
  passwordHash String
  role         Role      @default(CASHIER)
  refreshHash  String?
  active       Boolean   @default(true)
  mustChangePassword Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pharmacy     Pharmacy? @relation(fields: [pharmacyId], references: [id], onDelete: SetNull)
  sales        Sale[]

  @@unique([tenantId, email])
  @@index([tenantId, pharmacyId])
}

// Annuaire fournisseurs, partagé par toutes les pharmacies de l’organisation.
model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  email     String
  phone     String?
  category  String   @default("Grossiste répartiteur")
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, name])
}

enum PaymentMethod {
  CASH
  CARD
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

// Une vente encaissée au point de vente. Les montants sont figés au moment de l'encaissement.
model Sale {
  id             String        @id @default(cuid())
  number         Int
  tenantId       String
  pharmacyId     String
  userId         String?
  paymentMethod  PaymentMethod
  status         SaleStatus    @default(COMPLETED)
  totalHT        Decimal       @db.Decimal(14, 2)
  totalTVA       Decimal       @db.Decimal(14, 2)
  totalTTC       Decimal       @db.Decimal(14, 2)
  amountReceived Decimal?      @db.Decimal(14, 2)
  createdAt      DateTime      @default(now())
  cancelledAt    DateTime?
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pharmacy       Pharmacy      @relation(fields: [pharmacyId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  items          SaleItem[]

  @@index([tenantId, pharmacyId, createdAt])
  @@unique([pharmacyId, number])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String
  sku         String
  quantity    Int
  unitPriceHT Decimal @db.Decimal(12, 2)
  tvaRate     Decimal @db.Decimal(5, 2)
  lineHT      Decimal @db.Decimal(14, 2)
  lineTVA     Decimal @db.Decimal(14, 2)
  lineTTC     Decimal @db.Decimal(14, 2)
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}
