PORT=3001
NODE_ENV=development

# PostgreSQL local (compatible avec docker compose up -d postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmaos?schema=public"

# Cache Redis local
REDIS_HOST=localhost
REDIS_PORT=6379

# Sécurité & JWT
JWT_SECRET=super_secret_jwt_key_pour_dev_a_changer
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=super_refresh_token_key_dev
REFRESH_TOKEN_EXPIRES_IN=7d

# URL du frontend pour CORS
FRONTEND_URL=http://localhost:3000
